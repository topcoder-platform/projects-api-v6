{
  "name": "@topcoder/projects-api-v6",
  "version": "0.0.1",
  "description": "Generated Prisma client and PostgreSQL adapter factory for Topcoder Projects API v6",
  "license": "UNLICENSED",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
